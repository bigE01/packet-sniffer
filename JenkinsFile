pipeline {
    agent any

    environment {
        IMAGE_NAME = "packet-sniffer"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "starting build"
                sh "docker build -t ${IMAGE_NAME}:latest ."
            }
        }

        stage('Test') {
            steps {
                sh """
                    docker run --rm -v "${WORKSPACE}:/output" ${IMAGE_NAME}:latest sh -c \
                    'pytest test_packet_sniffer.py -v --junitxml=/output/results.xml'
                """
            }
            post {
                always {
                    junit 'results.xml'
                }
            }
        }

        stage('Run on PCAP') {
            steps {
                sh "docker run --rm ${IMAGE_NAME}:latest sh -c 'python packet_sniffer.py --mode pcap --file sample.pcap'"
            }
        }

        stage('Run on Live Interface') {
